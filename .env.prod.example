# Copy to .env.prod.local (gitignored) for docker-compose.prod.yml.
# Generate secrets with: openssl rand -hex 32   (use letters/digits only for DB passwords)

POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
CATALOG_DB_PASSWORD=
COMMERCE_DB_PASSWORD=
ELASTIC_PASSWORD=

# Shared by all services for service-to-service calls (min 16 chars).
INTERNAL_API_TOKEN=
# identity signs session cookies with it (min 8 chars).
JWT_SECRET=

# Public URLs (browser-facing).
WEB_PORT=8080
WEB_URL=http://localhost:8080
API_URL=http://localhost:3001

# Cloudflare R2 (optional locally: image upload is disabled without it).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
