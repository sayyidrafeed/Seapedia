# Generate a filled copy with: bun scripts/generate-secrets.ts > .env.prod.local
# Variables (all secrets are random, per environment):
#   IDENTITY_DB_PASSWORD, COMMERCE_DB_PASSWORD, CATALOG_DB_PASSWORD, CATALOG_DB_ROOT_PASSWORD
#   ELASTIC_PASSWORD
#   RABBITMQ_ADMIN_PASSWORD, RABBITMQ_{IDENTITY,CATALOG,COMMERCE,SEARCH}_PASSWORD
#   CATALOG_CLIENT_SECRET, SEARCH_CLIENT_SECRET, SEED_CLIENT_SECRET   (client credentials)
#   JWT_PRIVATE_KEY, JWT_PUBLIC_KEY   (RS256 PEM, "\n"-escaped, quoted)
#   WEB_PORT, WEB_URL, API_URL
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME, R2_PUBLIC_DOMAIN (optional)
