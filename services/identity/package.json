{
  "name": "@seapedia/identity",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/db/migrate.ts && bun src/index.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "fl": "bun run format && bun run lint",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.2",
    "@seapedia/contracts": "workspace:*",
    "@seapedia/platform": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.26",
    "hono-openapi": "^1.3.0",
    "jose": "^6.2.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "^26.0.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3"
  }
}
