# Local development (bun run dev). Infrastructure comes from `docker compose up -d`.
PORT=4001
DATABASE_URL=postgres://identity:identity@localhost:5432/identity
CONSUL_HTTP_ADDR=http://localhost:8500
RABBITMQ_URL=amqp://identity:identity@localhost:5672/seapedia
SERVICE_ADDRESS=host.docker.internal
SERVICE_CLIENT_SECRETS=catalog=dev-catalog-client-secret,search=dev-search-client-secret,seed=dev-seed-client-secret
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY: filled by `bun scripts/generate-secrets.ts --dev`
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
