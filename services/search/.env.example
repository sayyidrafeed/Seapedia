# Local development (bun run dev). Infrastructure comes from `docker compose up -d`.
PORT=4004
CONSUL_HTTP_ADDR=http://localhost:8500
RABBITMQ_URL=amqp://search:search@localhost:5672/seapedia
SERVICE_CLIENT_SECRET=dev-search-client-secret
SERVICE_ADDRESS=host.docker.internal
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic
# JWT_PUBLIC_KEY: see docs/SETUP.md (bun scripts/generate-secrets.ts --dev)
JWT_PUBLIC_KEY=
