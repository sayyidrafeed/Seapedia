# Local development (bun run dev). Databases come from `docker compose up -d`.
PORT=4002
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog
INTERNAL_API_TOKEN=dev-internal-token-change-me
IDENTITY_SERVICE_URL=http://localhost:4001
COMMERCE_SERVICE_URL=http://localhost:4003
# Leave empty to search with the database instead of Elasticsearch.
SEARCH_SERVICE_URL=http://localhost:4004
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
