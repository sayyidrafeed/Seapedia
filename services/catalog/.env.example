# Local development (bun run dev). Infrastructure comes from `docker compose up -d`.
PORT=4002
MONGODB_URL=mongodb://catalog:catalog@localhost:27017/catalog?replicaSet=rs0&authSource=catalog&directConnection=true
CONSUL_HTTP_ADDR=http://localhost:8500
RABBITMQ_URL=amqp://catalog:catalog@localhost:5672/seapedia
SERVICE_CLIENT_SECRET=dev-catalog-client-secret
SERVICE_ADDRESS=host.docker.internal
# JWT_PUBLIC_KEY: printed by `bun scripts/generate-secrets.ts --dev` (see docs/SETUP.md)
JWT_PUBLIC_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
